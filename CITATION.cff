    given-names: Ainiyaer
    affiliation: "College of Computer Science and Artificial Intelligence, Fudan University"
  - family-names: Chen
    given-names: Yutian
    affiliation: "College of Future Information Technology, Fudan University"
keywords:
  - changepoint detection
  - regularization paths
  - interval shortest paths
  - exact algorithms
  - witness certificates
  - segmentation
license: MIT
